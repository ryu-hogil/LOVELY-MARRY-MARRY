        // Sample initial hierarchy tasks
        const SAMPLE_TASKS = [
            { id: '1', title: '식전', level: 1, assignee: '공동', dueDate: '2026-11-30', startMonth: '2026-05', endMonth: '2026-11', budget: 15000000, expense: '12500000', memo: '식전 전체 예산 및 일정 총괄', status: '진행 중' },
            { id: '1-1', title: '사진', level: 2, assignee: '신부', dueDate: '2026-10-15', startMonth: '2026-06', endMonth: '2026-10', budget: 4500000, expense: '2000000 + 1800000', memo: '스튜디오 + 야외 스냅 총괄', status: '진행 중' },
            { id: '1-1-1', title: '사진관', level: 3, assignee: '신부', dueDate: '2026-08-20', startMonth: '2026-06', endMonth: '2026-08', budget: 2500000, expense: '2200000', memo: '실내 스튜디오 계약 완료', status: '완료' },
            { id: '1-1-1-1', title: '스튜디오 컨셉 가능 여부', level: 4, assignee: '신부', dueDate: '2026-07-10', startMonth: '2026-06', endMonth: '2026-07', budget: 0, expense: '0', memo: '인스타그램 샘플 확인 후 사전 미팅', status: '완료' },
            { id: '1-1-2', title: '야외스냅', level: 3, assignee: '신랑', dueDate: '2026-09-25', startMonth: '2026-07', endMonth: '2026-09', budget: 1500000, expense: '1600000', memo: '제주도 야외 촬영 예약 건', status: '긴급' },
            { id: '1-1-2-1', title: '업체선정', level: 4, assignee: '신랑', dueDate: '2026-07-30', startMonth: '2026-07', endMonth: '2026-07', budget: 0, expense: '0', memo: '작가 포트폴리오 비교 결정', status: '완료' },
            { id: '1-1-2-2', title: '컨셉', level: 4, assignee: '공동', dueDate: '2026-08-15', startMonth: '2026-08', endMonth: '2026-08', budget: 100000, expense: '80000', memo: '빈티지 및 자연주의 콘셉트 설정', status: '완료' },
            { id: '1-1-2-2-1', title: '참고 이미지 모으기 (5단계)', level: 5, assignee: '신부', dueDate: '2026-08-10', startMonth: '2026-08', endMonth: '2026-08', budget: 0, expense: '0', memo: '핀터레스트 보드 공유', status: '완료' },
            { id: '1-1-2-2-1-1', title: '세부 소품 색상 확정 (6단계)', level: 6, assignee: '시니', dueDate: '2026-08-12', startMonth: '2026-08', endMonth: '2026-08', budget: 50000, expense: '45000', memo: '파스텔 톤 리본 구비', status: '완료' },
            { id: '1-1-2-3', title: '장소협의', level: 4, assignee: '신랑', dueDate: '2026-08-30', startMonth: '2026-08', endMonth: '2026-08', budget: 0, expense: '0', memo: '동선 및 허가 장소 확인', status: '완료' },
            { id: '1-1-2-4', title: '의상', level: 4, assignee: '신부', dueDate: '2026-09-05', startMonth: '2026-08', endMonth: '2026-09', budget: 500000, expense: '550000', memo: '캐주얼 드레스 & 슈트 대여', status: '진행 중' },
            { id: '1-1-2-5', title: '메이크업', level: 4, assignee: '호기르', dueDate: '2026-09-15', startMonth: '2026-09', endMonth: '2026-09', budget: 300000, expense: '300000', memo: '현지 메이크업 샵 예약', status: '진행 중' },
            { id: '1-1-3', title: '셀프웨딩스냅', level: 3, assignee: '공동', dueDate: '2026-10-10', startMonth: '2026-09', endMonth: '2026-10', budget: 500000, expense: '250000', memo: '소품 및 촬영 도구 구비', status: '시작 전' },
            { id: '1-1-3-1', title: '촬영소품', level: 4, assignee: '신부', dueDate: '2026-09-20', startMonth: '2026-09', endMonth: '2026-09', budget: 150000, expense: '120000 + 30000', memo: '조화 부케, 가랜드 구매', status: '시작 전' },
            { id: '1-1-3-2', title: '촬영도구', level: 4, assignee: '신랑', dueDate: '2026-09-25', startMonth: '2026-09', endMonth: '2026-09', budget: 200000, expense: '100000', memo: '삼각대 및 리모컨 점검', status: '시작 전' },
            { id: '1-2', title: '웨딩밴드(반지) 맞추기', level: 2, assignee: '공동', dueDate: '2026-11-15', startMonth: '2026-08', endMonth: '2026-11', budget: 3500000, expense: '3200000', memo: '수령 및 인그레이빙 확인', status: '진행 중' },
            { id: '2', title: '웨딩홀 투어 및 계약', level: 1, assignee: '공동', dueDate: '2026-12-20', startMonth: '2026-05', endMonth: '2026-12', budget: 12000000, expense: '10000000 + 2000000', memo: '보증인원 및 피연장 계약', status: '완료' }
        ];

        // Safe expression evaluator for simple math calculations
        function safeEvaluateExpense(expr) {
            if (!expr) return 0;
            if (typeof expr === 'number') return expr;
            try {
                const clean = String(expr).replace(/[^0-9+\-*/().]/g, '');
                if (!clean) return 0;
                const evalFn = new Function(`return (${clean})`);
                const result = evalFn();
                return isNaN(result) || !isFinite(result) ? 0 : Math.max(0, result);
            } catch (e) {
                return 0;
            }
        }

        // Format numbers to Korean Won
        function formatWon(num) {
            const val = Math.round(Number(num) || 0);
            return val.toLocaleString('ko-KR') + '원';
        }

        // Hierarchy Prefix Calculator (Level 1 to Level 6)
        function getHierarchyPrefix(taskIndex, allTasks) {
            const task = allTasks[taskIndex];
            const level = task ? (task.level || 1) : 1;

            let parentIndex = -1;
            for (let j = taskIndex - 1; j >= 0; j--) {
                if (allTasks[j].level < level) {
                    parentIndex = j;
                    break;
                }
            }

            let siblingCount = 0;
            for (let k = parentIndex + 1; k <= taskIndex; k++) {
                if (allTasks[k].level === level) {
                    siblingCount++;
                }
            }
            siblingCount = Math.max(1, siblingCount);

            const koreanChar = (num) => {
                const chars = ['가', '나', '다', '라', '마', '바', '사', '아', '자', '차', '카', '타', '파', '하'];
                return chars[(num - 1) % chars.length];
            };

            if (level === 1) return `${siblingCount}.`;
            if (level === 2) return `${koreanChar(siblingCount)}.`;
            if (level === 3) return `${siblingCount})`;
            if (level === 4) return `${koreanChar(siblingCount)})`;
            if (level === 5) return `(${siblingCount})`;
            if (level === 6) return `(${koreanChar(siblingCount)})`;
            return `•`;
        }

        function App() {
            // LocalStorage persistence
            const [tasks, setTasks] = useState(() => {
                try {
                    const saved = localStorage.getItem('lambs_wedding_tasks');
                    return saved ? JSON.parse(saved) : SAMPLE_TASKS;
                } catch(e) {
                    return SAMPLE_TASKS;
                }
            });

            // Column Widths State (Resizable columns for 업무, 상한액, 지출액, 메모)
            // Default memo is 320px, budget is expanded to 160px with resize support
            const [colWidths, setColWidths] = useState(() => {
                try {
                    const saved = localStorage.getItem('lambs_wedding_col_widths');
                    return saved ? JSON.parse(saved) : { task: 400, budget: 160, expense: 180, memo: 320 };
                } catch(e) {
                    return { task: 400, budget: 160, expense: 180, memo: 320 };
                }
            });

            const [assignees, setAssignees] = useState(() => {
                try {
                    const saved = localStorage.getItem('lambs_wedding_assignees');
                    return saved ? JSON.parse(saved) : INITIAL_ASSIGNEES;
                } catch(e) {
                    return INITIAL_ASSIGNEES;
                }
            });

            // Save column widths to localStorage
            useEffect(() => {
                localStorage.setItem('lambs_wedding_col_widths', JSON.stringify(colWidths));
            }, [colWidths]);

            // Save to localStorage
            useEffect(() => {
                localStorage.setItem('lambs_wedding_tasks', JSON.stringify(tasks));
            }, [tasks]);

            useEffect(() => {
                localStorage.setItem('lambs_wedding_assignees', JSON.stringify(assignees));
            }, [assignees]);

            // Drag handler for column resizing
            const handleResizeMouseDown = (colKey, e) => {
                e.preventDefault();
                e.stopPropagation();
                const startX = e.clientX;
                const startWidth = colWidths[colKey] || 200;

                const onMouseMove = (moveEvent) => {
                    const deltaX = moveEvent.clientX - startX;
                    const minWidth = colKey === 'task' ? 240 : 100;
                    const newWidth = Math.max(minWidth, startWidth + deltaX);
                    setColWidths(prev => ({ ...prev, [colKey]: newWidth }));
                };

                const onMouseUp = () => {
                    window.removeEventListener('mousemove', onMouseMove);
                    window.removeEventListener('mouseup', onMouseUp);
                };

                window.addEventListener('mousemove', onMouseMove);
                window.addEventListener('mouseup', onMouseUp);
            };

            const handleResetColWidths = () => {
                setColWidths({ task: 400, budget: 160, expense: 180, memo: 320 });
            };

            // Timeline month range & count
            const [startYearMonth, setStartYearMonth] = useState('2026-05');
            const [monthCount, setMonthCount] = useState(12);

            // Filters & Search
            const [filterStatus, setFilterStatus] = useState('ALL');
            const [filterAssignee, setFilterAssignee] = useState('ALL');
            const [searchQuery, setSearchQuery] = useState('');

            // Popovers
            const [assigneeModalOpen, setAssigneeModalOpen] = useState(false);
            const [newAssigneeName, setNewAssigneeName] = useState('');
            const [activeAssigneeDropdown, setActiveAssigneeDropdown] = useState(null);
            const [activeStatusDropdown, setActiveStatusDropdown] = useState(null);

            // Save to localStorage
            useEffect(() => {
                localStorage.setItem('lambs_wedding_tasks', JSON.stringify(tasks));
            }, [tasks]);

            useEffect(() => {
                localStorage.setItem('lambs_wedding_assignees', JSON.stringify(assignees));
            }, [assignees]);

            // Re-render Lucide icons
            useEffect(() => {
                if (window.lucide) {
                    window.lucide.createIcons();
                }
            });

            // Generate timeline month objects
            const timelineMonths = useMemo(() => {
                const months = [];
                const [startYear, startMonth] = startYearMonth.split('-').map(Number);
                let currentY = startYear || 2026;
                let currentM = startMonth || 5;

                for (let i = 0; i < monthCount; i++) {
                    const formattedM = String(currentM).padStart(2, '0');
                    const key = `${currentY}-${formattedM}`;
                    months.push({
                        key,
                        year: currentY,
                        month: currentM,
                        label: `${currentM}월`,
                        fullLabel: `${currentY}년 ${currentM}월`
                    });

                    currentM++;
                    if (currentM > 12) {
                        currentM = 1;
                        currentY++;
                    }
                }
                return months;
            }, [startYearMonth, monthCount]);

            // Current month string
            const currentYearMonthKey = useMemo(() => {
                const now = new Date();
                const y = now.getFullYear();
                const m = String(now.getMonth() + 1).padStart(2, '0');
                return `${y}-${m}`;
            }, []);

            // Overall Summary Calculations
            const summaryData = useMemo(() => {
                let totalBudget = 0;
                let totalExpense = 0;
                let urgentCount = 0;
                let completedCount = 0;

                tasks.forEach(t => {
                    totalBudget += Number(t.budget || 0);
                    totalExpense += safeEvaluateExpense(t.expense);
                    if (t.status === '긴급') urgentCount++;
                    if (t.status === '완료') completedCount++;
                });

                const completionRate = tasks.length > 0 ? Math.round((completedCount / tasks.length) * 100) : 0;
                const remaining = totalBudget - totalExpense;

                return {
                    totalBudget,
                    totalExpense,
                    remaining,
                    urgentCount,
                    completedCount,
                    totalTasks: tasks.length,
                    completionRate
                };
            }, [tasks]);

            // Handlers
            const handleAddTask = (afterId = null, defaultLevel = 1) => {
                const newTask = {
                    id: Date.now().toString(),
                    title: '새 업무 항목',
                    level: defaultLevel,
                    assignee: '공동',
                    dueDate: '',
                    startMonth: timelineMonths[0]?.key || '2026-05',
                    endMonth: timelineMonths[3]?.key || '2026-08',
                    budget: 0,
                    expense: '0',
                    memo: '',
                    status: '시작 전'
                };

                if (!afterId) {
                    setTasks([...tasks, newTask]);
                    return;
                }

                const index = tasks.findIndex(t => t.id === afterId);
                const updated = [...tasks];
                updated.splice(index + 1, 0, newTask);
                setTasks(updated);
            };

            const handleUpdateTask = (id, field, value) => {
                setTasks(prev => prev.map(t => t.id === id ? { ...t, [field]: value } : t));
            };

            const handleDeleteTask = (id) => {
                setTasks(prev => prev.filter(t => t.id !== id));
            };

            const handleIndent = (id, direction) => {
                setTasks(prev => prev.map(t => {
                    if (t.id === id) {
                        const newLevel = direction === 'increase' ? Math.min(6, t.level + 1) : Math.max(1, t.level - 1);
                        return { ...t, level: newLevel };
                    }
                    return t;
                }));
            };

            const handleDeleteAssignee = (assigneeId) => {
                if (assignees.length <= 1) return;
                setAssignees(prev => prev.filter(a => a.id !== assigneeId));
                setTasks(prev => prev.map(t => t.assignee === assigneeId ? { ...t, assignee: '공동' } : t));
            };

            const handleAddAssignee = () => {
                if (!newAssigneeName.trim()) return;
                const colorOptions = [
                    'bg-purple-100 text-purple-900 border-purple-200 hover:bg-purple-200',
                    'bg-indigo-100 text-indigo-900 border-indigo-200 hover:bg-indigo-200',
                    'bg-emerald-100 text-emerald-900 border-emerald-200 hover:bg-emerald-200',
                    'bg-amber-100 text-amber-900 border-amber-200 hover:bg-amber-200',
                    'bg-rose-100 text-rose-900 border-rose-200 hover:bg-rose-200'
                ];
                const randomColor = colorOptions[Math.floor(Math.random() * colorOptions.length)];
                const newAssignee = {
                    id: newAssigneeName.trim(),
                    label: newAssigneeName.trim(),
                    bg: randomColor
                };
                setAssignees([...assignees, newAssignee]);
                setNewAssigneeName('');
                setAssigneeModalOpen(false);
            };

            const handleMonthClick = (task, monthKey) => {
                let start = task.startMonth;
                let end = task.endMonth;

                if (!start || !end) {
                    start = monthKey;
                    end = monthKey;
                } else if (monthKey < start) {
                    start = monthKey;
                } else if (monthKey > end) {
                    end = monthKey;
                } else {
                    start = monthKey;
                    end = monthKey;
                }

                handleUpdateTask(task.id, 'startMonth', start);
                handleUpdateTask(task.id, 'endMonth', end);
            };

            const handleExportData = () => {
                const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(tasks, null, 2));
                const downloadAnchor = document.createElement('a');
                downloadAnchor.setAttribute("href", dataStr);
                downloadAnchor.setAttribute("download", `양들의_혼례_예식준비_${new Date().toISOString().slice(0, 10)}.json`);
                document.body.appendChild(downloadAnchor);
                downloadAnchor.click();
                downloadAnchor.remove();
            };

            const handleImportData = (e) => {
                const fileReader = new FileReader();
                if (e.target.files[0]) {
                    fileReader.readAsText(e.target.files[0], "UTF-8");
                    fileReader.onload = (event) => {
                        try {
                            const parsed = JSON.parse(event.target.result);
                            if (Array.isArray(parsed)) {
                                setTasks(parsed);
                            }
                        } catch (err) {
                            // ignore err
                        }
                    };
                }
            };

            const handleResetData = () => {
                setTasks(SAMPLE_TASKS);
                setAssignees(INITIAL_ASSIGNEES);
            };

            // Filtered Tasks list
            const filteredTasks = useMemo(() => {
                return tasks.filter(t => {
                    const matchesStatus = filterStatus === 'ALL' || t.status === filterStatus;
                    const matchesAssignee = filterAssignee === 'ALL' || t.assignee === filterAssignee;
                    const matchesSearch = !searchQuery || t.title.toLowerCase().includes(searchQuery.toLowerCase()) || (t.memo && t.memo.toLowerCase().includes(searchQuery.toLowerCase()));
                    return matchesStatus && matchesAssignee && matchesSearch;
                });
