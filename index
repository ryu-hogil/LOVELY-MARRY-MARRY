                                                                    value={task.dueDate || ''}
                                                                    onChange={(e) => handleUpdateTask(task.id, 'dueDate', e.target.value)}
                                                                    className="bg-transparent text-xs font-medium text-slate-700 outline-none text-center cursor-pointer hover:bg-slate-100 rounded px-1 py-0.5"
                                                                />
                                                                {task.dueDate && (
                                                                    <span className="text-[10px] text-slate-400 font-mono">
                                                                        {(() => {
                                                                            const diff = Math.ceil((new Date(task.dueDate) - new Date()) / (1000 * 60 * 60 * 24));
                                                                            if (isNaN(diff)) return '';
                                                                            if (diff === 0) return 'D-Day';
                                                                            return diff > 0 ? `D-${diff}` : `D+${Math.abs(diff)}`;
                                                                        })()}
                                                                    </span>
                                                                )}
                                                            </div>
                                                        </td>

                                                        {/* 수정사항1: COLUMN 4 스케줄 게이지 (동적 달 수 대응 및 가로 스크롤 가능) */}
                                                        <td className="py-2 px-2 border-r border-slate-200" style={{ minWidth: `${Math.max(280, monthCount * 42)}px` }}>
                                                            <div 
                                                                className="grid gap-px bg-slate-200/80 rounded p-0.5 relative select-none"
                                                                style={{ gridTemplateColumns: `repeat(${monthCount}, minmax(40px, 1fr))` }}
                                                            >
                                                                {timelineMonths.map(m => {
                                                                    const isCurrentMonth = m.key === currentYearMonthKey;
                                                                    const isInRange = task.startMonth && task.endMonth && (m.key >= task.startMonth && m.key <= task.endMonth);
                                                                    const isStart = m.key === task.startMonth;
                                                                    const isEnd = m.key === task.endMonth;

                                                                    return (
                                                                        <div
                                                                            key={m.key}
                                                                            onClick={() => handleMonthClick(task, m.key)}
                                                                            title={`${m.fullLabel} (클릭하여 범위를 변경하세요)`}
                                                                            className={`h-7 rounded-sm cursor-pointer transition-all flex items-center justify-center relative ${
                                                                                isCurrentMonth ? 'bg-rose-100/60' : 'bg-white'
                                                                            }`}
                                                                        >
                                                                            {/* Current Month Highlight Dot */}
                                                                            {isCurrentMonth && (
                                                                                <div className="absolute top-0.5 right-0.5 w-1.5 h-1.5 rounded-full bg-rose-500"></div>
                                                                            )}

                                                                            {/* Active Gauge Bar */}
                                                                            {isInRange && (
                                                                                <div className={`w-full h-5 flex items-center justify-center font-bold text-[10px] text-white shadow-2xs transition-all ${
                                                                                    task.status === '완료' ? 'bg-emerald-500 hover:bg-emerald-600' :
                                                                                    task.status === '긴급' ? 'bg-rose-500 hover:bg-rose-600' :
                                                                                    task.status === '진행 중' ? 'bg-blue-500 hover:bg-blue-600' :
                                                                                    'bg-slate-400 hover:bg-slate-500'
                                                                                } ${isStart ? 'rounded-l-md' : ''} ${isEnd ? 'rounded-r-md' : ''}`}>
                                                                                    {isStart && <span className="px-0.5 truncate">{m.month}월</span>}
                                                                                </div>
                                                                            )}
                                                                        </div>
                                                                    );
                                                                })}
                                                            </div>
                                                        </td>

                                                        {/* COLUMN 5: 상한액 (Dynamic Resizable Width) */}
                                                        <td 
                                                            style={{ width: `${colWidths.budget || 160}px`, minWidth: `${colWidths.budget || 160}px` }}
                                                            className="py-2 px-2 border-r border-slate-200 text-right"
                                                        >
                                                            <input
                                                                type="number"
                                                                value={task.budget || 0}
                                                                onChange={(e) => handleUpdateTask(task.id, 'budget', Number(e.target.value))}
                                                                className="w-full bg-transparent text-right font-mono text-xs text-slate-800 font-semibold outline-none hover:bg-slate-100 focus:bg-white focus:ring-1 focus:ring-wedding-500 rounded px-1.5 py-1"
                                                                step="10000"
                                                            />
                                                            <span className="text-[10px] text-slate-400 block font-mono">
                                                                {formatWon(task.budget)}
                                                            </span>
                                                        </td>

                                                        {/* COLUMN 6: 지출액 (Dynamic Resizable Width) */}
                                                        <td 
                                                            style={{ width: `${colWidths.expense}px`, minWidth: `${colWidths.expense}px` }}
                                                            className="py-2 px-2 border-r border-slate-200 text-right"
                                                        >
                                                            <input
                                                                type="text"
                                                                value={task.expense || ''}
                                                                placeholder="예: 100000+50000"
                                                                onChange={(e) => handleUpdateTask(task.id, 'expense', e.target.value)}
                                                                className="w-full bg-transparent text-right font-mono text-xs text-slate-800 font-semibold outline-none hover:bg-slate-100 focus:bg-white focus:ring-1 focus:ring-wedding-500 rounded px-1.5 py-1"
                                                            />
                                                            <div className="flex items-center justify-end gap-1 mt-0.5">
                                                                <span className="text-[10px] text-slate-500 font-mono">
                                                                    {formatWon(evaluatedExpense)}
                                                                </span>
                                                                {task.budget > 0 && (
                                                                    <span className={`text-[9px] font-mono px-1 rounded ${
                                                                        variance < 0 ? 'bg-rose-100 text-rose-700 font-bold' : 'text-emerald-600'
                                                                    }`}>
                                                                        {variance < 0 ? `초과 ${formatWon(Math.abs(variance))}` : `절감`}
                                                                    </span>
                                                                )}
                                                            </div>
                                                        </td>

                                                        {/* COLUMN 7: 메모 (Dynamic Resizable Width & Default 320px) */}
                                                        <td 
                                                            style={{ width: `${colWidths.memo}px`, minWidth: `${colWidths.memo}px` }}
                                                            className="py-2 px-2 border-r border-slate-200"
                                                        >
                                                            <input
                                                                type="text"
                                                                value={task.memo || ''}
                                                                placeholder="긴 메모나 전달사항도 넉넉하게 작성하세요..."
                                                                onChange={(e) => handleUpdateTask(task.id, 'memo', e.target.value)}
                                                                className="w-full bg-transparent text-xs text-slate-600 outline-none hover:bg-slate-100 focus:bg-white focus:ring-1 focus:ring-wedding-500 rounded px-1.5 py-1"
                                                            />
                                                        </td>

                                                        {/* COLUMN 8: 진행 상태 */}
                                                        <td className="py-2 px-2 text-center relative w-[145px] min-w-[145px]">
                                                            <div className="flex items-center justify-center gap-1.5 w-full">
                                                                <div className="relative inline-block text-left flex-1 min-w-[90px]">
                                                                    <button
                                                                        onClick={() => setActiveStatusDropdown(activeStatusDropdown === task.id ? null : task.id)}
                                                                        className={`w-full px-2 py-1 rounded-full text-[11px] font-bold border flex items-center justify-between gap-1 shadow-2xs transition-transform active:scale-95 ${statusInfo.color}`}
                                                                    >
                                                                        <span className="flex items-center gap-1.5 mx-auto whitespace-nowrap">
                                                                            <span className={`w-1.5 h-1.5 rounded-full ${statusInfo.dot}`}></span>
                                                                            {task.status}
                                                                        </span>
                                                                        <i data-lucide="chevron-down" className="w-3 h-3 opacity-60 shrink-0"></i>
                                                                    </button>

                                                                    {/* Status Popover */}
                                                                    {activeStatusDropdown === task.id && (
                                                                        <div className="absolute right-0 top-full mt-1 w-32 bg-white rounded-xl shadow-xl border border-slate-200 z-50 p-1.5 space-y-1">
                                                                            {Object.values(STATUSES).map(s => (
                                                                                <button
                                                                                    key={s.id}
                                                                                    onClick={() => {
                                                                                        handleUpdateTask(task.id, 'status', s.id);
                                                                                        setActiveStatusDropdown(null);
                                                                                    }}
                                                                                    className={`w-full text-left px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center justify-between transition-colors border ${s.color}`}
                                                                                >
                                                                                    <span className="flex items-center gap-1.5 whitespace-nowrap">
                                                                                        <span className={`w-1.5 h-1.5 rounded-full ${s.dot}`}></span>
                                                                                        {s.label}
                                                                                    </span>
                                                                                    {task.status === s.id && <i data-lucide="check" className="w-3 h-3"></i>}
                                                                                </button>
                                                                            ))}
                                                                        </div>
                                                                    )}
                                                                </div>

                                                                {/* Reliable Direct Row Delete Button (X) */}
                                                                <button
                                                                    onClick={() => handleDeleteTask(task.id)}
                                                                    className="p-1 hover:bg-rose-100 text-slate-400 hover:text-rose-600 rounded-lg transition-colors shrink-0"
                                                                    title="행 삭제하기"
                                                                >
                                                                    <i data-lucide="x" className="w-4 h-4"></i>
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                );
                                            })
                                        )}
                                    </tbody>
                                </table>
                            </div>

                            {/* Matrix Footer Bar */}
                            <div className="bg-slate-50 p-3 border-t border-slate-200 flex flex-wrap items-center justify-between text-xs text-slate-500 gap-3">
                                <div className="flex items-center gap-3">
                                    <button
                                        onClick={() => handleAddTask(null, 1)}
                                        className="text-wedding-700 hover:text-wedding-800 font-bold flex items-center gap-1 bg-white border border-wedding-200 px-3 py-1.5 rounded-lg shadow-2xs hover:bg-rose-50/50 transition-all"
                                    >
                                        <i data-lucide="plus" className="w-3.5 h-3.5"></i>
                                        새 업무 추가
                                    </button>
                                    <span>총 {filteredTasks.length}개 항목 표시 중</span>
                                </div>
                                <div className="flex items-center gap-4 font-mono text-[11px]">
                                    <span>상한액 합계: <strong className="text-slate-800">{formatWon(summaryData.totalBudget)}</strong></span>
                                    <span>지출액 합계: <strong className="text-amber-800">{formatWon(summaryData.totalExpense)}</strong></span>
                                </div>
                            </div>
                        </div>
                    </main>

                    {}
                    {/* Custom Assignee Addition Modal */}
                    {assigneeModalOpen && (
                        <div className="fixed inset-0 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center z-50 p-4">
                            <div className="bg-white rounded-2xl p-6 w-full max-w-md shadow-2xl border border-slate-100">
                                <h3 className="text-base font-bold text-slate-800 mb-2 flex items-center gap-2">
                                    <i data-lucide="user-plus" className="w-5 h-5 text-wedding-700"></i>
                                    새 담당자 추가
                                </h3>
                                <p className="text-xs text-slate-500 mb-4">
                                    업무를 담당할 신규 항목명을 입력해주세요 (예: 신랑 모친, 플래너, 시부모님 등).
                                </p>
                                <input
                                    type="text"
                                    placeholder="담당자 이름..."
                                    value={newAssigneeName}
                                    onChange={(e) => setNewAssigneeName(e.target.value)}
                                    className="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-wedding-500/50 mb-4"
                                    autoFocus
                                />
                                <div className="flex justify-end gap-2 text-xs">
                                    <button
                                        onClick={() => setAssigneeModalOpen(false)}
                                        className="px-4 py-2 text-slate-500 hover:bg-slate-100 rounded-xl font-medium"
                                    >
                                        취소
                                    </button>
                                    <button
                                        onClick={handleAddAssignee}
                                        className="px-4 py-2 bg-wedding-700 hover:bg-wedding-800 text-white font-bold rounded-xl shadow-md"
                                    >
                                        추가하기
                                    </button>
                                </div>
                            </div>
                        </div>
                    )}
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
